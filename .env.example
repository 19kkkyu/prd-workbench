AI_PROVIDER=openai
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=prd-files
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Absolute directory on a persistent disk in production
DATA_DIR=./data
MAX_FILE_MB=200
MAX_DOCUMENT_CHARS=600000
CHUNK_CHARS=18000
# Actual application-side daily request limit (shared by all users)
DAILY_CALL_LIMIT=150
